<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F1">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Header -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMART PANTRY"
                android:textColor="#D97745"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Good food starts here."
                android:textColor="#3D3029"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A little planning goes a long way. Let's make something good."
                android:textColor="#87766B"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp" />

            <!-- Featured recipe card -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#B95735"
                android:padding="22dp"
                android:layout_marginTop="26dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FROM PANTRY TO PLATE"
                    android:textColor="#FFE2D1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What's cooking today?"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Discover recipes that match the ingredients and quantities you already have."
                    android:textColor="#FFF0E7"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnRecipes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Explore recipes  →"
                    android:textAllCaps="false"
                    android:textColor="#8E432B"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginTop="18dp" />

            </LinearLayout>

            <!-- Quick access heading -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your kitchen"
                android:textColor="#3D3029"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="14dp" />

            <!-- Pantry card -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="18dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01  |  INGREDIENTS"
                    android:textColor="#D97745"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your Pantry"
                    android:textColor="#3D3029"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add ingredients, update quantities and keep track of expiry dates."
                    android:textColor="#87766B"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="5dp" />

                <Button
                    android:id="@+id/btnPantry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Manage ingredients"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D97745"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- Helpful reminder -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F6D7C3"
                android:padding="18dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🍑  A little kitchen wisdom"
                    android:textColor="#8E432B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use what you have, plan what you need, and waste a little less."
                    android:textColor="#694638"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- Footer -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PLAN SMARTER  •  COOK BETTER  •  WASTE LESS"
                android:textColor="#A18F82"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom navigation -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Home: selected -->

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="#D97745"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Pantry -->

        <TextView
            android:id="@+id/navPantry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▤\nPantry"
            android:textColor="#87766B"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Recipes -->

        <TextView
            android:id="@+id/navRecipes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡\nRecipes"
            android:textColor="#87766B"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Settings -->

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙\nSettings"
            android:textColor="#87766B"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>
