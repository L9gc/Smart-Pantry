<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F1">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Header -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAKE SOMETHING GOOD"
                android:textColor="#D97745"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Suggested Recipes"
                android:textColor="#3D3029"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Discover meals you can make with the ingredients already in your pantry."
                android:textColor="#87766B"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <!-- Featured card -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#B95735"
                android:elevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COOK WITH CONFIDENCE"
                    android:textColor="#FFE2D1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Make every ingredient count."
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Discover recipes that match your available ingredients and quantities."
                    android:textColor="#FFF0E7"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- Recipe list heading -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Ready to cook"
                android:textColor="#3D3029"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="16dp"
                android:text="Recipes matched to your current ingredients."
                android:textColor="#87766B"
                android:textSize="14sp" />

            <!-- Empty state -->

            <TextView
                android:id="@+id/txtEmptyRecipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="No matching recipes yet.\n\nAdd more ingredients to your pantry to discover meals you can make."
                android:textColor="#87766B"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone" />

            <!-- Recipes RecyclerView -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRecipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom navigation -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Home -->

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="#87766B"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Pantry -->

        <TextView
            android:id="@+id/navPantry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▤\nPantry"
            android:textColor="#87766B"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Recipes: selected -->

        <TextView
            android:id="@+id/navRecipes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡\nRecipes"
            android:textColor="#D97745"
            android:textStyle="bold"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Settings -->

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙\nSettings"
            android:textColor="#87766B"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>
