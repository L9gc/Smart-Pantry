<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F2">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR KITCHEN"
                android:textColor="#39856A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Pantry"
                android:textColor="#20352D"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Everything you have, all in one place."
                android:textColor="#68766E"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp" />

            <!-- Featured action card -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#246B52"
                android:padding="22dp"
                android:layout_marginTop="26dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INGREDIENT MANAGEMENT"
                    android:textColor="#C8E8D6"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Know what you have."
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Track quantities, manage expiry dates and keep your kitchen organized."
                    android:textColor="#E1F0E7"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnAddIngredient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+  Add ingredient"
                    android:textColor="#245B46"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginTop="18dp" />

            </LinearLayout>

            <!-- Ingredient list heading -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your ingredients"
                android:textColor="#20352D"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Review and update what's in your pantry."
                android:textColor="#68766E"
                android:textSize="14sp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/txtEmptyPantry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="24dp"
                android:gravity="center"
                android:text="Your pantry is waiting.&#10;Add your first ingredient to get started."
                android:textColor="#68766E"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPantry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom navigation -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Home"
            android:textColor="#68766E"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openHome" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▤&#10;Pantry"
            android:textColor="#246B52"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙&#10;Settings"
            android:textColor="#68766E"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="openSettings" />

    </LinearLayout>

</LinearLayout>
